# Configuracion de CorePlanner. Copiar a .env y ajustar.

COREPLANNER_DATABASE_URL=sqlite+aiosqlite:///./coreplanner.db
COREPLANNER_DATABASE_ECHO=false

# Obligatorio cambiar en cualquier despliegue real.
COREPLANNER_JWT_SECRET_KEY=cambia-esta-clave-en-produccion
COREPLANNER_JWT_ALGORITHM=HS256
COREPLANNER_ACCESS_TOKEN_EXPIRE_MINUTES=480
