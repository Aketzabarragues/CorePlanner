# Variables del frontend. Vite solo expone las que empiezan por VITE_.

# Acceso automatico con el administrador de demostracion
# (admin@example.com / coreplanner).
#
#   sin valor -> activo solo en desarrollo
#   true      -> activo tambien en una compilacion de produccion
#   false     -> desactivado siempre
#
# En un despliegue real debe quedar en false: cada persona entra con sus
# credenciales.
VITE_DEMO_AUTO_LOGIN=false
